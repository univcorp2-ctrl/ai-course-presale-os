# Runtime
ENVIRONMENT=development
AUTOMATION_ENABLED=false
PUBLISH_MODE=draft
APPROVED_RELEASE_ID=
STATE_DB_PATH=var/courseforge.db
ARTIFACT_DIR=artifacts

# Content sources
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_STATUS_PROPERTY=Status
NOTION_ALLOWED_STATUSES=Approved,Reference
NOTION_CONFIDENTIALITY_PROPERTY=Confidentiality
NOTION_ALLOWED_CONFIDENTIALITIES=Public
NOTION_ALLOWED_USE_PROPERTY=Allowed Use
NOTION_ALLOWED_USES=Summarize,Publish

# Model providers. Keep secrets in GitHub Secrets or a local .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
CODEX_MODEL=gpt-5-codex
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
ANTIGRAVITY_MODEL=antigravity-preview-05-2026
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Resource controls
MAX_PAID_CALLS_PER_RUN=4
DAILY_PAID_TOKEN_BUDGET=120000
MONTHLY_PAID_TOKEN_BUDGET=1500000
MIN_REVIEW_AGENTS=2

# Commerce. Secret keys never enter browser code or repository files.
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_URL=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:8000/thanks
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_PUBLICATION_ID=

# Required before live selling in Japan. Do not commit personal data.
LEGAL_SELLER_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_PAYMENT_TIMING=
LEGAL_DELIVERY_TIMING=
LEGAL_REFUND_POLICY=
LEGAL_ADDITIONAL_FEES=
